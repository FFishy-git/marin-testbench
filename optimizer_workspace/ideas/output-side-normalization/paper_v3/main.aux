\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Three-trajectory structural and temporal audit across all 11 Transformer second moments} (\texttt  {130M}, $352$ FP32 EMA matrices across $L=32$ layers) comparing unpreconditioned Muon, input-whitened MuonT, and active two-sided WT-MLP-Lag (WT). Metric groups 1--5 report step-$2{,}500$ ($1.31\text  {B}$-token) 32-layer medians; $\mathrm  {Drift}_{16}$ reports the 32-layer mean over steps $2{,}250 \to 2{,}500$. Across all three trajectories, pre-SwiGLU expansion outputs (\texttt  {out:gate}, \texttt  {out:up}) hug the $0.0052$ sampling floor with $78\%\text  {--}91\%$ diagonal anisotropy ($R^2 = 76\%\text  {--}99\%$), whereas residual-stream outputs (\texttt  {out:o}, \texttt  {out:down}) remain $\ge 99\%$ rotational ($\mathrm  {DiagAniso} = 0.8\%\text  {--}1.0\%$).}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:diagnosis}{{1}{6}{\textbf {Three-trajectory structural and temporal audit across all 11 Transformer second moments} (\texttt {130M}, $352$ FP32 EMA matrices across $L=32$ layers) comparing unpreconditioned \mname {Muon}, input-whitened \mname {MuonT}, and active two-sided \mname {WT-MLP-Lag} (\mname {WT}). Metric groups 1--5 report step-$2{,}500$ ($1.31\text {B}$-token) 32-layer medians; $\mathrm {Drift}_{16}$ reports the 32-layer mean over steps $2{,}250 \to 2{,}500$. Across all three trajectories, pre-SwiGLU expansion outputs (\texttt {out:gate}, \texttt {out:up}) hug the $0.0052$ sampling floor with $78\%\text {--}91\%$ diagonal anisotropy ($R^2 = 76\%\text {--}99\%$), whereas residual-stream outputs (\texttt {out:o}, \texttt {out:down}) remain $\ge 99\%$ rotational ($\mathrm {DiagAniso} = 0.8\%\text {--}1.0\%$)}{table.caption.5}{}}
