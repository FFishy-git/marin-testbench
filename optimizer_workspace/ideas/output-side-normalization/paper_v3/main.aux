\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Confirmatory and scaling results across fresh seeds, longer horizon, and greater width.} Held-out reports final cross-entropy $\mathcal  {L}_{\mathrm  {sel}}$ in nats; all $\Delta $ columns report differences from same-regime Muon in millinats (negative favors the row method). MuonT applies input preconditioning only, so the gap between the MuonT and WT-MLP-Lag rows isolates the output-side contribution. Late-11 averages the 11 second-half checkpoints; Wins counts the 16 Paloma domains improved over Muon. At 130M, all four methods share their bracketed seed-0 optimum ($\eta ^*=0.01600$ at 20 TPP and $0.01600\times 4^{-0.3}=0.01056$ at 80 TPP); at 520M Muon runs at its own selected rate while the preconditioned methods share MuonT's pinned rate, so that block compares each method at its chosen rate rather than at a matched one. Complete absolute losses and $\eta =0.02263$ replicates appear in \Cref  {tab:absolute_results,tab:seeds}.}}{10}{table.caption.29}\protected@file@percent }
\newlabel{tab:main_scaling}{{5}{10}{\textbf {Confirmatory and scaling results across fresh seeds, longer horizon, and greater width.} Held-out reports final cross-entropy $\Lsel $ in nats; all $\Delta $ columns report differences from same-regime Muon in millinats (negative favors the row method). MuonT applies input preconditioning only, so the gap between the MuonT and WT-MLP-Lag rows isolates the output-side contribution. Late-11 averages the 11 second-half checkpoints; Wins counts the 16 Paloma domains improved over Muon. At 130M, all four methods share their bracketed seed-0 optimum ($\eta ^*=0.01600$ at 20 TPP and $0.01600\times 4^{-0.3}=0.01056$ at 80 TPP); at 520M Muon runs at its own selected rate while the preconditioned methods share MuonT's pinned rate, so that block compares each method at its chosen rate rather than at a matched one. Complete absolute losses and $\eta =0.02263$ replicates appear in \Cref {tab:absolute_results,tab:seeds}}{table.caption.29}{}}
\newlabel{tab:main_scaling@cref}{{[table][5][]5}{[1][9][]10}{}{}{}}
