\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Out-of-distribution generalization across all 16 Paloma benchmark domains.} Horizontal bars connect pure-diagonal OD-All ($\blacktriangle $) and width-thresholded WT-MLP-Lag ($\bullet $) relative to same-regime matched-LR MuonT (vertical dashed line at $0$); MuonT is used as the reference here, rather than Muon, so that the per-domain differences between the two output treatments remain visible. Against Muon, WT-MLP-Lag wins $16/16$ domains at $4\times $ (macro $-16.78 \times 10^{-3}$ nats) and $15/16$ at \texttt  {520M} (macro $-8.93 \times 10^{-3}$). \textbf  {(a)} At \texttt  {130M} $4\times $ Chinchilla ($80$ TPP, $10.74\text  {B}$ tokens), WT-MLP-Lag improves over MuonT on every single domain ($16/16$, macro $\Delta = -5.66 \times 10^{-3}$ nats). \textbf  {(b)} At \texttt  {520M} ($d=1{,}024$, $10.74\text  {B}$ tokens), OD-All scatters around zero ($6/16$ wins, $+0.47 \times 10^{-3}$ macro; it remains ahead of Muon, just no longer ahead of MuonT), whereas WT-MLP-Lag wins $15/16$ domains (macro $\Delta = -5.45 \times 10^{-3}$ nats).}}{17}{figure.caption.25}\protected@file@percent }
\newlabel{fig:paloma}{{6}{17}{\textbf {Out-of-distribution generalization across all 16 Paloma benchmark domains.} Horizontal bars connect pure-diagonal \mname {OD-All} ($\blacktriangle $) and width-thresholded \mname {WT-MLP-Lag} ($\bullet $) relative to same-regime matched-LR \mname {MuonT} (vertical dashed line at $0$); \mname {MuonT} is used as the reference here, rather than \mname {Muon}, so that the per-domain differences between the two output treatments remain visible. Against \mname {Muon}, \mname {WT-MLP-Lag} wins $16/16$ domains at $4\times $ (macro $-16.78 \times 10^{-3}$ nats) and $15/16$ at \texttt {520M} (macro $-8.93 \times 10^{-3}$). \textbf {(a)} At \texttt {130M} $4\times $ Chinchilla ($80$ TPP, $10.74\text {B}$ tokens), \mname {WT-MLP-Lag} improves over \mname {MuonT} on every single domain ($16/16$, macro $\Delta = -5.66 \times 10^{-3}$ nats). \textbf {(b)} At \texttt {520M} ($d=1{,}024$, $10.74\text {B}$ tokens), \mname {OD-All} scatters around zero ($6/16$ wins, $+0.47 \times 10^{-3}$ macro; it remains ahead of \mname {Muon}, just no longer ahead of \mname {MuonT}), whereas \mname {WT-MLP-Lag} wins $15/16$ domains (macro $\Delta = -5.45 \times 10^{-3}$ nats)}{figure.caption.25}{}}
\newlabel{fig:paloma@cref}{{[figure][6][]6}{[1][15][]17}{}{}{}}
