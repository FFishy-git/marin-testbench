\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {Steady-state \texttt  {520M} ($d=1{,}024$, $1\text  {M}$-token batch) step-time and memory scaling across $8\times \text  {A100}$ and $32\times \text  {A100}$} (\texttt  {bench\_520m\_opt}, mid-training step-$5{,}120$ checkpoint). Chunked row buffers ($\texttt  {chunk}=2$, unlocking $\text  {microbatch } 2$) paired with non-blocking GPU-masked repairs and single-call batched \texttt  {eigh} fallbacks cut single-node latency by $8\text  {--}12\%$, while $32\times \text  {A100}$ ($4\times 8$ RDMA, $1$ layer/GPU, $4$-microbatch accumulation) brings WT-MLP-Lag overhead down to $+3.27\%$ ($+5.56\%$ when resumed from each arm's independent step-$5{,}120$ covariance/basis state). For chunked $8\times \text  {A100}$, steady-state post-EMA warmup medians (steps $73\text  {--}96$) are reported alongside full-window (steps $37\text  {--}96$) values in parentheses.}}{28}{table.caption.39}\protected@file@percent }
\newlabel{tab:bench520m}{{8}{28}{\textbf {Steady-state \texttt {520M} ($d=1{,}024$, $1\text {M}$-token batch) step-time and memory scaling across $8\times \text {A100}$ and $32\times \text {A100}$} (\texttt {bench\_520m\_opt}, mid-training step-$5{,}120$ checkpoint). Chunked row buffers ($\texttt {chunk}=2$, unlocking $\text {microbatch } 2$) paired with non-blocking GPU-masked repairs and single-call batched \texttt {eigh} fallbacks cut single-node latency by $8\text {--}12\%$, while $32\times \text {A100}$ ($4\times 8$ RDMA, $1$ layer/GPU, $4$-microbatch accumulation) brings \mname {WT-MLP-Lag} overhead down to $+3.27\%$ ($+5.56\%$ when resumed from each arm's independent step-$5{,}120$ covariance/basis state). For chunked $8\times \text {A100}$, steady-state post-EMA warmup medians (steps $73\text {--}96$) are reported alongside full-window (steps $37\text {--}96$) values in parentheses}{table.caption.39}{}}
\newlabel{tab:bench520m@cref}{{[table][8][]8}{[1][27][]28}{}{}{}}
