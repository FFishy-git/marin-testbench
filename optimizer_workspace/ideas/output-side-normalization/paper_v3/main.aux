\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Eliminating hyperparameter and execution-path confounds (\texttt  {130M}, seed 0).} \textbf  {(a)} Screening matrix learning rates on a $6\%$-budget ($320$-step, $0.17\text  {B}$-token) short schedule shifts apparent optima $3\times $--$4\times $ higher ($0.064$--$0.0905$); transferring those LRs to the full $5{,}120$-step horizon degrades MuonT itself by $+0.1001$ nats late $\mathcal  {L}_{\mathrm  {sel}}$ ($+0.042$ final) and pushes OD-All over a $+0.087$-nat stability cliff. \textbf  {(b)} Full-budget ($5{,}120$-step, $2.68\text  {B}$-token) LR bracketing over $\{0.016, 0.0226, 0.032\}$ locates the true flat optimum basin and confirms that WT-MLP-Lag outperforms MuonT at every matched LR ($-0.0038$ to $-0.0043$ nats), while same-wave Null-WT ($\star $) matches MuonT to $-0.0003$ nats. \textbf  {(c)} Across all 10 late-stage checkpoints ($\text  {steps } 3{,}001\text  {--}5{,}120$), Null-WT stays tightly around zero while WT-MLP-Lag wins $10/10$ checkpoints at both $\eta =0.016$ and $\eta =0.0226$.}}{13}{figure.caption.19}\protected@file@percent }
\newlabel{fig:confounds}{{4}{13}{\textbf {Eliminating hyperparameter and execution-path confounds (\texttt {130M}, seed 0).} \textbf {(a)} Screening matrix learning rates on a $6\%$-budget ($320$-step, $0.17\text {B}$-token) short schedule shifts apparent optima $3\times $--$4\times $ higher ($0.064$--$0.0905$); transferring those LRs to the full $5{,}120$-step horizon degrades \mname {MuonT} itself by $+0.1001$ nats late $\Lsel $ ($+0.042$ final) and pushes \mname {OD-All} over a $+0.087$-nat stability cliff. \textbf {(b)} Full-budget ($5{,}120$-step, $2.68\text {B}$-token) LR bracketing over $\{0.016, 0.0226, 0.032\}$ locates the true flat optimum basin and confirms that \mname {WT-MLP-Lag} outperforms \mname {MuonT} at every matched LR ($-0.0038$ to $-0.0043$ nats), while same-wave \mname {Null-WT} ($\star $) matches \mname {MuonT} to $-0.0003$ nats. \textbf {(c)} Across all 10 late-stage checkpoints ($\text {steps } 3{,}001\text {--}5{,}120$), \mname {Null-WT} stays tightly around zero while \mname {WT-MLP-Lag} wins $10/10$ checkpoints at both $\eta =0.016$ and $\eta =0.0226$}{figure.caption.19}{}}
