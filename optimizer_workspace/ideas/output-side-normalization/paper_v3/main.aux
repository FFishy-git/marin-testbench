\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Factor assignment and execution pipeline of WT-MLP-Lag.} \textbf  {(a)} The four factor slots of \Cref  {eq:update}. Right input factors stay dense for every projection, as in MuonT (grey); the left output factor is chosen by the width of the cotangent, dense spectral roots at $d_{\mathrm  {model}}$ (blue) and exact per-step diagonal scaling at $d_{\mathrm  {ff}}$ (teal). Chip labels give each moment's $\mathrm  {DiagAniso}$ on the MuonT trajectory (\Cref  {tab:diagnosis}), the measurement that sets the threshold. \textbf  {(b)} One training step at \texttt  {130M} on $8\times \text  {A100}$, drawn to scale from the median step times of \Cref  {tab:bench19}. Synchronous two-sided execution appends \texttt  {syrk}, \texttt  {reduce\_scatter}, and fallback \texttt  {eigh} to the step boundary, since $\delta _t$ exists only after backward completes. At $\tau =1$ the step-$t$ update instead consumes $L_{t-1}$, and the output pipeline runs on a priority-0 side stream: \texttt  {syrk} ($\sim 1.5\text  { ms}$, guarded by \texttt  {ev\_rows\_consumed}) followed by reduction and root updates for $L_t$ hidden under step $t+1$. Only the step bars are to scale; side-stream extents are schematic.}}{11}{figure.caption.13}\protected@file@percent }
\newlabel{fig:method_pipeline}{{3}{11}{\textbf {Factor assignment and execution pipeline of \mname {WT-MLP-Lag}.} \textbf {(a)} The four factor slots of \Cref {eq:update}. Right input factors stay dense for every projection, as in \mname {MuonT} (grey); the left output factor is chosen by the width of the cotangent, dense spectral roots at $\dm $ (blue) and exact per-step diagonal scaling at $\dff $ (teal). Chip labels give each moment's $\mathrm {DiagAniso}$ on the \mname {MuonT} trajectory (\Cref {tab:diagnosis}), the measurement that sets the threshold. \textbf {(b)} One training step at \texttt {130M} on $8\times \text {A100}$, drawn to scale from the median step times of \Cref {tab:bench19}. Synchronous two-sided execution appends \texttt {syrk}, \texttt {reduce\_scatter}, and fallback \texttt {eigh} to the step boundary, since $\delta _t$ exists only after backward completes. At $\tau =1$ the step-$t$ update instead consumes $L_{t-1}$, and the output pipeline runs on a priority-0 side stream: \texttt {syrk} ($\sim 1.5\text { ms}$, guarded by \texttt {ev\_rows\_consumed}) followed by reduction and root updates for $L_t$ hidden under step $t+1$. Only the step bars are to scale; side-stream extents are schematic}{figure.caption.13}{}}
\newlabel{fig:method_pipeline@cref}{{[figure][3][]3}{[1][9][]11}{}{}{}}
