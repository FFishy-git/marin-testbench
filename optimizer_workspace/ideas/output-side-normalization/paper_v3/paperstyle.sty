\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{paperstyle}[2026/11/25 Research manuscript typography]
\RequirePackage{xcolor}
\RequirePackage{tgheros}
\RequirePackage{lmodern}
\renewcommand{\familydefault}{\sfdefault}
\renewcommand{\sfdefault}{qhv}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{fancyhdr}
\RequirePackage{environ}
\RequirePackage[skip=5.5pt plus 1pt minus 1pt]{parskip}
\RequirePackage{hyperref}
\definecolor{pageink}{HTML}{202A35}
\definecolor{pagemuted}{HTML}{586777}
\definecolor{pageaccent}{HTML}{2459A6}
\definecolor{pagerule}{HTML}{DCE3EB}
\hypersetup{linkcolor=pageaccent,citecolor=pageaccent,urlcolor=pageaccent}
\AtBeginDocument{\color{pageink}\fontsize{10.5}{14}\selectfont}
\titleformat{\section}{\sffamily\bfseries\large\color{pageink}}{\textcolor{pageaccent}{\thesection}}{0.65em}{}
\titleformat{\subsection}{\sffamily\bfseries\normalsize\color{pageink}}{\textcolor{pageaccent}{\thesubsection}}{0.65em}{}
\titleformat{\subsubsection}{\sffamily\bfseries\normalsize}{}{0pt}{}
\titleformat{\paragraph}[runin]{\sffamily\bfseries\normalsize}{}{0pt}{}
\titlespacing*{\section}{0pt}{17pt plus 3pt minus 2pt}{6pt}
\titlespacing*{\subsection}{0pt}{12pt plus 2pt minus 1pt}{4pt}
\titlespacing*{\paragraph}{0pt}{6pt}{0.65em}
\captionsetup{font={small,sf},labelfont={bf,color=pageaccent},labelsep=period,justification=raggedright,singlelinecheck=false,skip=7pt}
\captionsetup[table]{position=top}
\setlength{\textfloatsep}{17pt plus 3pt minus 3pt}
\setlength{\floatsep}{15pt plus 2pt minus 2pt}
\setlength{\intextsep}{15pt plus 2pt minus 2pt}
\renewcommand{\arraystretch}{1.18}
\setlength{\tabcolsep}{5pt}
\setlength{\headheight}{14pt}
\newcommand{\papershorttitle}[1]{\gdef\paperstyle@short{#1}}
\newcommand{\paperaffiliations}[1]{\gdef\paperstyle@affiliation{#1}}
\newcommand{\paperstyle@short}{}
\newcommand{\paperstyle@affiliation}{}
\fancypagestyle{paper}{\fancyhf{}\fancyhead[L]{\sffamily\footnotesize\color{pagemuted}\paperstyle@short}\fancyhead[R]{\sffamily\footnotesize\color{pagemuted}\thepage}\renewcommand{\headrulewidth}{0pt}}
\fancypagestyle{paperfirst}{\fancyhf{}\fancyfoot[C]{\sffamily\footnotesize\color{pagemuted}\thepage}\renewcommand{\headrulewidth}{0pt}}
\renewcommand{\maketitle}{\thispagestyle{paperfirst}\begingroup\raggedright
{\color{pageaccent}\rule{35pt}{2.5pt}\par}\vspace{9pt}
{\sffamily\bfseries\fontsize{24}{28}\selectfont\@title\par}\vspace{10pt}
{\sffamily\fontsize{10}{13}\selectfont\@author\quad\textcolor{pagemuted}{\paperstyle@affiliation}\par}
\vspace{13pt}\endgroup}
\RenewEnviron{abstract}{\begingroup\noindent{\sffamily\bfseries\color{pageaccent}Abstract}\par\vspace{2pt}
\fontsize{10}{13.2}\selectfont\BODY\par\vspace{10pt}{\color{pagerule}\hrule}\endgroup\vspace{6pt}}
\renewcommand{\bibfont}{\fontsize{9}{11}\selectfont}
\setlength{\bibsep}{3pt}
\setlength{\@fptop}{0pt}
\endinput
