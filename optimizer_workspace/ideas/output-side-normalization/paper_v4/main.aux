\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Factor assignment and nominal output $O(d^3)$ share across core methods.} Dense and Diag denote the $(-1/2,-1/8)$ factor pairs in \Cref  {eq:dense_roots,eq:diag_roots}. Splitting both sides by projection role and width ($d_{\mathrm  {model}}$ versus $d_{\mathrm  {ff}}=4d_{\mathrm  {model}}$) highlights the structural asymmetry: Muon2-ExpDiag retains dense factors on the $d_{\mathrm  {ff}}$-wide \texttt  {down} input while diagonalizing the two $d_{\mathrm  {ff}}$-wide gated MLP expansion outputs (\texttt  {gate,up}). Fine-grained placement ablations appear in \Cref  {tab:ablations}.}}{6}{table.caption.13}\protected@file@percent }
