\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Structure-aware factor assignment and asynchronous execution pipeline of Muon2-ExpDiag.} \textbf  {(a)} Update rule and role-matched output classes: dense spectral factors on the five $d_{\mathrm  {model}}$-wide outputs (\texttt  {q,k,v,o,down}), inline exact diagonal scaling on the two $d_{\mathrm  {ff}}$-wide gated MLP expansion outputs (\texttt  {gate,up}), and dense input factors throughout. Chip percentages preview each output moment's diagonal share of anisotropy along MuonT (\Cref  {sec:diagnosis}, \Cref  {fig:structural_audit}(a)). \textbf  {(b)} Single-step execution timeline at 130M scaled to measured eight-A100 medians (\Cref  {tab:bench19}). Synchronous Muon2-ExpDiag (sync) stalls at the step boundary waiting for output reductions and fallback eigensolves; with a one-update lag ($\tau =1$), Muon2-ExpDiag applies ready factors immediately while computing new output roots alongside step $t+1$.}}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:method_pipeline}{{2}{7}{\textbf {Structure-aware factor assignment and asynchronous execution pipeline of \mname {Muon2-ExpDiag}.} \textbf {(a)} Update rule and role-matched output classes: dense spectral factors on the five $\dm $-wide outputs (\texttt {q,k,v,o,down}), inline exact diagonal scaling on the two $\dff $-wide gated MLP expansion outputs (\texttt {gate,up}), and dense input factors throughout. Chip percentages preview each output moment's diagonal share of anisotropy along \mname {MuonT} (\Cref {sec:diagnosis}, \Cref {fig:structural_audit}(a)). \textbf {(b)} Single-step execution timeline at 130M scaled to measured eight-A100 medians (\Cref {tab:bench19}). Synchronous \mname {Muon2-ExpDiag (sync)} stalls at the step boundary waiting for output reductions and fallback eigensolves; with a one-update lag ($\tau =1$), \mname {Muon2-ExpDiag} applies ready factors immediately while computing new output roots alongside step $t+1$}{figure.caption.15}{}}
