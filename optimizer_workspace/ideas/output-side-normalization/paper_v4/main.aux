\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Muon2-ExpDiag allocates dense output preconditioning where cross-channel geometry concentrates.} \textbf  {(a)} Diagonal and off-diagonal shares of anisotropy across all 11 block second moments (130M, Muon trajectory, step 2,500; 32-layer medians of $\mathrm  {DiagAniso}$ in \cref  {eq:diag_aniso} and $1-\mathrm  {DiagAniso}$). The split shows where departure from isotropy lies in the coordinate basis rather than its total magnitude. The cost column gives each moment's share of nominal two-sided dense eigendecomposition work; teal marks the two expanded outputs (\texttt  {gate,up}) that Muon2-ExpDiag diagonalizes, which account for 96.2\% of output-side cubic work while carrying mostly diagonal anisotropy. The equally wide \texttt  {down} input remains cross-channel correlated and stays dense. \textbf  {(b)} Final held-out mixture and 16-domain Paloma loss reductions versus Muon at 520M against median step-time overhead on 32 A100 GPUs (one seed). Muon2-ExpDiag extends MuonT's quality gain with modest median overhead, whereas all-diagonal output scaling (Muon2-Diag) adds almost no held-out gain and falls behind MuonT on Paloma.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:overview}{{1}{2}{\textbf {\mname {Muon2-ExpDiag} allocates dense output preconditioning where cross-channel geometry concentrates.} \textbf {(a)} Diagonal and off-diagonal shares of anisotropy across all 11 block second moments (130M, \mname {Muon} trajectory, step 2,500; 32-layer medians of $\mathrm {DiagAniso}$ in \cref {eq:diag_aniso} and $1-\mathrm {DiagAniso}$). The split shows where departure from isotropy lies in the coordinate basis rather than its total magnitude. The cost column gives each moment's share of nominal two-sided dense eigendecomposition work; teal marks the two expanded outputs (\texttt {gate,up}) that \mname {Muon2-ExpDiag} diagonalizes, which account for 96.2\% of output-side cubic work while carrying mostly diagonal anisotropy. The equally wide \texttt {down} input remains cross-channel correlated and stays dense. \textbf {(b)} Final held-out mixture and 16-domain Paloma loss reductions versus \mname {Muon} at 520M against median step-time overhead on 32 A100 GPUs (one seed). \mname {Muon2-ExpDiag} extends \mname {MuonT}'s quality gain with modest median overhead, whereas all-diagonal output scaling (\mname {Muon2-Diag}) adds almost no held-out gain and falls behind \mname {MuonT} on Paloma}{figure.caption.2}{}}
\newlabel{fig:overview@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}
