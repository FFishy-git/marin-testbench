\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Factor assignment and asynchronous execution pipeline of WT-MLP-Lag.} \textbf  {(a)} Update rule and width-thresholded output classes: dense spectral factors on the five $d_{\mathrm  {model}}$-wide outputs (\texttt  {q,k,v,o,down}), inline exact diagonal scaling on the two $d_{\mathrm  {ff}}$-wide expansion outputs (\texttt  {gate,up}), and dense input factors throughout. Chip percentages preview each output moment's diagonal share of anisotropy along MuonT (\Cref  {sec:diagnosis}). \textbf  {(b)} Single-step execution timeline at 130M scaled to measured eight-A100 medians (\Cref  {tab:bench19}). Synchronous WT-MLP stalls at the step boundary waiting for output reductions and fallback eigensolves; with a one-update lag ($\tau =1$), WT-MLP-Lag applies ready factors immediately while computing new output roots alongside step $t+1$.}}{6}{figure.caption.14}\protected@file@percent }
\newlabel{fig:method_pipeline}{{2}{6}{\textbf {Factor assignment and asynchronous execution pipeline of \mname {WT-MLP-Lag}.} \textbf {(a)} Update rule and width-thresholded output classes: dense spectral factors on the five $\dm $-wide outputs (\texttt {q,k,v,o,down}), inline exact diagonal scaling on the two $\dff $-wide expansion outputs (\texttt {gate,up}), and dense input factors throughout. Chip percentages preview each output moment's diagonal share of anisotropy along \mname {MuonT} (\Cref {sec:diagnosis}). \textbf {(b)} Single-step execution timeline at 130M scaled to measured eight-A100 medians (\Cref {tab:bench19}). Synchronous \mname {WT-MLP} stalls at the step boundary waiting for output reductions and fallback eigensolves; with a one-update lag ($\tau =1$), \mname {WT-MLP-Lag} applies ready factors immediately while computing new output roots alongside step $t+1$}{figure.caption.14}{}}
