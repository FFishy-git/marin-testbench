\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Visualizing ``Loud-Channel Hijacking'' inside Muon's polar step---and its cure.} \textbf  {(a)} Clean feature matrix $M_{\mathrm  {true}}$ has perpendicular axes at $45^\circ $ ($\sigma _1=2.0$) and $135^\circ $ ($\sigma _2=0.5$). \textbf  {(b)} When Output Row~1 is $10\times $ louder in error noise ($Z_0$), both feature vectors get squashed toward the horizontal $x$-axis ($5.7^\circ $ and $174.3^\circ $). \textbf  {(c)} Forcing $90^\circ $ orthogonality via $\operatorname  {polar}(Z_0)$ lets loud Column~1 bully quiet Column~2 off course by $\mathbf  {26.2^\circ }$ ($18.85^\circ $, dashed red), whereas inner normalization $\operatorname  {polar}(L Z_0)$ restores the exact $45^\circ $ axes (solid blue). \textbf  {(d)} Across all 32 layers of a real \texttt  {130M} Transformer, top-16 noisy error directions hijack $30\%\text  {--}68\%$ of MuonT's top-16 pre-polar singular axes (red); applying $L = B^{-1/2}$ drops hijacking right onto the $3.1\%$ fair-chance baseline (blue).}}{9}{figure.caption.37}\protected@file@percent }
\newlabel{fig:hijacking}{{4}{9}{\textbf {Visualizing ``Loud-Channel Hijacking'' inside \mname {Muon}'s polar step---and its cure.} \textbf {(a)} Clean feature matrix $M_{\mathrm {true}}$ has perpendicular axes at $45^\circ $ ($\sigma _1=2.0$) and $135^\circ $ ($\sigma _2=0.5$). \textbf {(b)} When Output Row~1 is $10\times $ louder in error noise ($Z_0$), both feature vectors get squashed toward the horizontal $x$-axis ($5.7^\circ $ and $174.3^\circ $). \textbf {(c)} Forcing $90^\circ $ orthogonality via $\polar (Z_0)$ lets loud Column~1 bully quiet Column~2 off course by $\mathbf {26.2^\circ }$ ($18.85^\circ $, dashed red), whereas inner normalization $\polar (L Z_0)$ restores the exact $45^\circ $ axes (solid blue). \textbf {(d)} Across all 32 layers of a real \texttt {130M} Transformer, top-16 noisy error directions hijack $30\%\text {--}68\%$ of \mname {MuonT}'s top-16 pre-polar singular axes (red); applying $L = B^{-1/2}$ drops hijacking right onto the $3.1\%$ fair-chance baseline (blue)}{figure.caption.37}{}}
\newlabel{fig:hijacking@cref}{{[figure][4][]4}{[1][9][]9}{}{}{}}
