\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Axis-aligned vs.\ tilted error ovals---from 2D geometry to real \texttt  {130M} and \texttt  {520M} Transformers.} \textbf  {(a)} When the error oval aligns with neuron axes ($B_{\mathrm  {aligned}}$), shadows on Neuron~1 and Neuron~2 differ sharply ($1.96$ vs.\ $0.04$), so 1D diagonal scaling sees $100\%$ of the distortion. \textbf  {(b)} Tilting the exact same oval by $45^\circ $ ($B_{\mathrm  {tilted}}$) makes the Neuron~1 and Neuron~2 shadows \emph  {identical} ($B_{11}=B_{22}=1.00$), leaving diagonal scaling $100\%$ blind! \textbf  {(c)} Real Transformer output moments mirror both extremes: SwiGLU-gated \texttt  {out:gate, up} sit at $78\%\text  {--}82\%$ diagonal, whereas residual-stream \texttt  {out:o, down} sit below $1\%$ diagonal at \texttt  {130M} ($d=512$) and shrink further to $0.50\%$ at \texttt  {520M} ($d=1{,}024$)---with \texttt  {out:v} collapsing $12\times $ from $12.2\% \to 1.0\%$.}}{7}{figure.caption.27}\protected@file@percent }
\newlabel{fig:tilted}{{3}{7}{\textbf {Axis-aligned vs.\ tilted error ovals---from 2D geometry to real \texttt {130M} and \texttt {520M} Transformers.} \textbf {(a)} When the error oval aligns with neuron axes ($B_{\mathrm {aligned}}$), shadows on Neuron~1 and Neuron~2 differ sharply ($1.96$ vs.\ $0.04$), so 1D diagonal scaling sees $100\%$ of the distortion. \textbf {(b)} Tilting the exact same oval by $45^\circ $ ($B_{\mathrm {tilted}}$) makes the Neuron~1 and Neuron~2 shadows \emph {identical} ($B_{11}=B_{22}=1.00$), leaving diagonal scaling $100\%$ blind! \textbf {(c)} Real Transformer output moments mirror both extremes: SwiGLU-gated \texttt {out:gate, up} sit at $78\%\text {--}82\%$ diagonal, whereas residual-stream \texttt {out:o, down} sit below $1\%$ diagonal at \texttt {130M} ($d=512$) and shrink further to $0.50\%$ at \texttt {520M} ($d=1{,}024$)---with \texttt {out:v} collapsing $12\times $ from $12.2\% \to 1.0\%$}{figure.caption.27}{}}
\newlabel{fig:tilted@cref}{{[figure][3][]3}{[1][6][]7}{}{}{}}
