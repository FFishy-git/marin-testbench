\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Visual primer on eigenvectors, singular vectors, and Muon.} \textbf  {(a)} Plotting backward error vectors $\delta $ over a batch forms an ellipse; the eigenvectors $q_1, q_2$ of $B = \mathbb  {E}[\delta \delta ^{{\mathsf  {T}}}]$ are simply the ellipse's perpendicular principal axes, and $\sqrt  {\beta _1}, \sqrt  {\beta _2}$ are its widths. \textbf  {(b)} A raw momentum matrix $M = U\Sigma V^{{\mathsf  {T}}}$ stretches one axis vastly more than another ($\sigma _1 \gg \sigma _2$, dashed red), starving quiet features; Muon's polar step $\operatorname  {polar}(M) = U V^{{\mathsf  {T}}}$ resets all stretches to $1$ (solid blue circle), making the choice of axes $(U, V)$ the entire update. \textbf  {(c)} Because $G = \DOTSB \sum@ \slimits@ \delta x^{{\mathsf  {T}}}$, input-only MuonT fixes the right-hand input ellipse $C$ while leaving the left-hand backward error ellipse $B$ unfixed.}}{4}{figure.caption.14}\protected@file@percent }
\newlabel{fig:primer}{{2}{4}{\textbf {Visual primer on eigenvectors, singular vectors, and \mname {Muon}.} \textbf {(a)} Plotting backward error vectors $\delta $ over a batch forms an ellipse; the eigenvectors $q_1, q_2$ of $B = \E [\delta \delta ^{\Tr }]$ are simply the ellipse's perpendicular principal axes, and $\sqrt {\beta _1}, \sqrt {\beta _2}$ are its widths. \textbf {(b)} A raw momentum matrix $M = U\Sigma V^{\Tr }$ stretches one axis vastly more than another ($\sigma _1 \gg \sigma _2$, dashed red), starving quiet features; \mname {Muon}'s polar step $\polar (M) = U V^{\Tr }$ resets all stretches to $1$ (solid blue circle), making the choice of axes $(U, V)$ the entire update. \textbf {(c)} Because $G = \sum \delta x^{\Tr }$, input-only \mname {MuonT} fixes the right-hand input ellipse $C$ while leaving the left-hand backward error ellipse $B$ unfixed}{figure.caption.14}{}}
\newlabel{fig:primer@cref}{{[figure][2][]2}{[1][3][]4}{}{}{}}
