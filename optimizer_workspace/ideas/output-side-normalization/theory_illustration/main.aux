\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Why the rotated update system wins---locally in steep canyons and globally across 250+ steps.} \textbf  {(a)} Inner $L = B^{-1/2}$ and outer $\hat  {L} = \operatorname  {unitRMS}(B^{-1/8})$ perform $90^\circ $-orthogonal jobs: \textbf  {(1)}~inner $L$ rotates \emph  {tangentially along the unit circle} to point away from loud error spikes toward true input--error correlation, while \textbf  {(2)}~outer $\hat  {L}$ reshapes step lengths \emph  {perpendicular to the circle}, shrinking steps into steep canyon walls ($\beta _1$) and lengthening steps along gentle valley floors ($\beta _2$). \textbf  {(b)} At \texttt  {520M} ($d_{\mathrm  {model}}=1{,}024$), dense WT-MLP-Lag boosts net downhill progress per unit canyon curvature ($\Phi _{B,C}$) by $1.59\times \text  {--}2.00\times $ on \texttt  {v, q, k} and $1.09\times \text  {--}1.10\times $ on residual \texttt  {o, down}, whereas diagonal OD-All flatlines at $1.00\times $ on residual writers. \textbf  {(c)} Over 250 training steps, avoiding canyon-wall overshoots slows backward error-oval spinning ($\mathrm  {Drift}_{16}$) by $11\%\text  {--}40\%$ across all seven layer types, allowing 20-step Nesterov momentum to accumulate cleanly.}}{11}{figure.caption.41}\protected@file@percent }
\newlabel{fig:canyon}{{5}{11}{\textbf {Why the rotated update system wins---locally in steep canyons and globally across 250+ steps.} \textbf {(a)} Inner $L = B^{-1/2}$ and outer $\hat {L} = \unitrms (B^{-1/8})$ perform $90^\circ $-orthogonal jobs: \textbf {(1)}~inner $L$ rotates \emph {tangentially along the unit circle} to point away from loud error spikes toward true input--error correlation, while \textbf {(2)}~outer $\hat {L}$ reshapes step lengths \emph {perpendicular to the circle}, shrinking steps into steep canyon walls ($\beta _1$) and lengthening steps along gentle valley floors ($\beta _2$). \textbf {(b)} At \texttt {520M} ($\dm =1{,}024$), dense \mname {WT-MLP-Lag} boosts net downhill progress per unit canyon curvature ($\Phi _{B,C}$) by $1.59\times \text {--}2.00\times $ on \texttt {v, q, k} and $1.09\times \text {--}1.10\times $ on residual \texttt {o, down}, whereas diagonal \mname {OD-All} flatlines at $1.00\times $ on residual writers. \textbf {(c)} Over 250 training steps, avoiding canyon-wall overshoots slows backward error-oval spinning ($\mathrm {Drift}_{16}$) by $11\%\text {--}40\%$ across all seven layer types, allowing 20-step Nesterov momentum to accumulate cleanly}{figure.caption.41}{}}
\newlabel{fig:canyon@cref}{{[figure][5][]5}{[1][10][]11}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Reason 2: Outer $\hat  {L} = \operatorname  {unitRMS}(B^{-1/8})$ Cushions Steep Canyon Walls ($90^\circ $ to Inner $L$)}{11}{subsection*.44}\protected@file@percent }
